{
  "source": {
    "path": "./input/agendaAnonimizado.xlsx",
    "format": "excel",
    "sheet": "AGENDA_1"
  },
  "mapping": "mapping.json",
  "validation": {
    "required": ["AG_ID", "PROF_ID", "ESP_ID", "BENEF_ID", "TBLPROCED_ID", "PLANO_ID", "CLI_ID", "TPA_ID", "USER_ID", "DTHORAAGENDA", "AG_STATUSAGENDAMENTO"],
    "ranges": {
      "AGP_VALOR": { "minimum": 0 },
      "BENEF_ID": { "maximum": 9223372036854775807 },
      "AG_ID": { "maximum": 2147483647 },
      "PROF_ID": { "maximum": 2147483647 },
      "ESP_ID": { "maximum": 2147483647 },
      "TBLPROCED_ID": { "maximum": 2147483647 },
      "PLANO_ID": { "maximum": 2147483647 },
      "CLI_ID": { "maximum": 2147483647 },
      "SALA_ID": { "maximum": 2147483647 },
      "TPA_ID": { "maximum": 2147483647 },
      "TBL_IDCID": { "maximum": 2147483647 },
      "USER_ID": { "maximum": 2147483647 }
    },
    "max_lengths": {
      "BENEF_NOME": 255
    },
    "rejection_threshold": "5%",
    "business_key": ["AG_ID", "BENEF_ID", "PROF_ID", "DTHORAAGENDA"],
    "on_duplicate": "discard"
  },
  "database": {
    "jdbc_url": "jdbc:mysql://savir005.vpshost12372.mysql.dbaas.com.br:3306/savir005",
    "user": "savir005",
    "password": "Carlos#2025",
    "driver": "com.mysql.cj.jdbc.Driver",
    "num_partitions": 1,
    "batch_size": 1000,
    "socket_timeout": 600000
  },
  "load": {
    "table": "AGENDAMENTO",
    "mode": "append",
    "truncate": false,
    "output_format": "jdbc",
    "delta_path": "hdfs:///output/agendamentos_delta"
  },
  "spark": {
    "app_name": "ETL Agendamentos - Big Data",
    "shuffle_partitions": 200,
    "executor_memory": "4g",
    "num_executors": 4
  },
  "run": {
    "execute_schema": true,
    "log_level": "WARN",
    "log_file": "etl.log"
  }
}
